<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Push Notifications (APNs) -->
    <key>aps-environment</key>
    <string>production</string>
    
    <!-- Background Modes -->
    <key>com.apple.developer.background-modes</key>
    <array>
        <string>location</string>
        <string>remote-notification</string>
        <string>fetch</string>
        <string>processing</string>
    </array>
    
    <!-- DeviceActivity / Screen Time -->
    <key>com.apple.developer.device-activity</key>
    <true/>
    
    <!-- Managed App Configuration (MDM) -->
    <key>com.apple.developer.managed-app-configuration</key>
    <true/>
    
    <!-- Network Extension (si usas NEFilterProvider para filtrado DNS/VPN) -->
    <!-- <key>com.apple.developer.networking.networkextension</key>
    <true/> -->
    
    <!-- Wi-Fi Info (SSID, BSSID) -->
    <key>com.apple.developer.networking.wifi-info</key>
    <true/>
    
    <!-- App Groups (si compartes datos con extension) -->
    <!-- <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.tuorg.institucional</string>
    </array> -->
    
    <!-- Keychain Access Groups -->
    <!-- <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.tuorg.institucional</string>
    </array> -->
    
    <!-- App Sandbox (no aplica a iOS, solo macOS) -->
    <!-- <key>com.apple.security.app-sandbox</key>
    <true/> -->
</dict>
</plist>